{
	"luci-app-lucky": {
		"description": "Grant UCI and RPC access for luci-app-lucky",
		"read": {
			"file": {
				"/usr/bin/lucky": [ "stat" ],
				"/usr/bin/lucky -info": [ "exec" ],
				"/usr/libexec/lucky-gate info *": [ "exec" ],
				"/usr/bin/luckyarch": [ "exec" ]
			},
			"ubus": {
				"file": [ "exec", "stat" ],
				"service": [ "list" ]
			},
			"uci": [ "lucky" ]
		},
		"write": {
			"file": {
				"/usr/libexec/lucky-gate set *": [ "exec" ],
				"/etc/init.d/lucky": [ "exec" ],
				"/etc/init.d/lucky *": [ "exec" ]
			},
			"ubus": {
				"file": [ "exec" ]
			},
			"uci": [ "lucky" ]
		}
	}
}
